<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F4F7F5"
    android:orientation="vertical">

    <!-- Encabezado Institucional Verde UTEQ -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#0B5D2A"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingHorizontal="20dp"
        android:paddingTop="24dp"
        android:paddingBottom="20dp">

        <ImageView
            android:id="@+id/ivLogoUteq"
            android:layout_width="95dp"
            android:layout_height="95dp"
            android:layout_marginBottom="10dp"
            android:background="#FFFFFF"
            android:contentDescription="Logo UTEQ"
            android:padding="8dp"
            android:src="@drawable/logouteq" />

        <TextView
            android:id="@+id/tvTitulo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Listado de Alumnos"
            android:textColor="#FFFFFF"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="Universidad Técnica Estatal de Quevedo"
            android:textColor="#E8D27A"
            android:textSize="13sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Línea decorativa dorada -->
    <View
        android:layout_width="match_parent"
        android:layout_height="4dp"
        android:background="#D4AF37" />

    <!-- Cuerpo principal -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="20dp">

        <Button
            android:id="@+id/btnCargar"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginBottom="16dp"
            android:backgroundTint="#0F7A3A"
            android:text="CARGAR ALUMNOS"
            android:textColor="#FFFFFF"
            android:textSize="15sp"
            android:textStyle="bold"
            app:cornerRadius="10dp" />

        <EditText
            android:id="@+id/etResultados"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="#FFFFFF"
            android:clickable="false"
            android:ems="10"
            android:focusable="false"
            android:gravity="start|top"
            android:hint="Presiona el botón para consultar los registros..."
            android:inputType="textMultiLine"
            android:padding="16dp"
            android:textColor="#1B3A26"
            android:textColorHint="#7A8C80"
            android:textSize="15sp" />

    </LinearLayout>

</LinearLayout>